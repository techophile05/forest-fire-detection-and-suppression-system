# ESP8266 LoRa gateway
ESP_IP=10.152.162.188
ESP_PORT=80
ESP_POLL_INTERVAL=2
ESP_TIMEOUT=5
ESP_STALE_SECONDS=15
ESP_DATA_PATH=/data
ESP_DEPLOY_PATH=/deploy

# Flask server
FLASK_HOST=0.0.0.0
FLASK_PORT=8080
FLASK_DEBUG=false

# Email alerts (Gmail app password or SMTP credentials — never commit real values)
EMAIL_USER=
EMAIL_PASSWORD=
ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
ALERT_COOLDOWN_SECONDS=300
ALERT_MIN_LEVEL=high

# Deterministic risk score (single calculator)
RISK_TEMP_LOW=25
RISK_TEMP_MID=30
RISK_TEMP_HIGH=35
RISK_HUM_HIGH=70
RISK_HUM_MID=50
RISK_HUM_LOW=30
RISK_GAS_LOW=100
RISK_GAS_MID=150
RISK_GAS_HIGH=200
RISK_PRESSURE_LOW=1000
RISK_PRESSURE_MID=1010
RISK_WEIGHT_TEMPERATURE=0.40
RISK_WEIGHT_HUMIDITY=0.30
RISK_WEIGHT_GAS=0.25
RISK_WEIGHT_PRESSURE=0.05
RISK_LEVEL_LOW=15
RISK_LEVEL_MODERATE=35
RISK_LEVEL_HIGH=55
RISK_LEVEL_CRITICAL=75

# Random Forest — place a real labeled CSV at ML_DATASET_PATH to replace the baseline
# Expected columns: temperature,humidity,mq4,label
# Optional column: pressure  (add it to ML_FEATURES only when the ESP transmits it)
# label values: None | Potential Fire | Confirmed Fire
ML_FEATURES=temperature,humidity,mq4
ML_DATASET_PATH=data/fire_labels.csv
ML_MODEL_PATH=models/fire_rf.joblib
ML_N_ESTIMATORS=100
ML_RANDOM_STATE=42
ML_ENABLE_BASELINE=true
HISTORY_MAX=60

